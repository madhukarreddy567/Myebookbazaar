APP_NAME="MyEbookBazaar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000
# Railway always sits behind its own proxy: set to * on Railway so signed
# download URLs validate and request()->ip() returns the real visitor IP.
# Set to * when behind Cloudflare (see DEPLOY.md section 10); leave empty otherwise.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Database: MySQL ONLY (Phase 1 spec) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=myebookbazaar
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Secure session cookies are auto-detected from APP_URL (on for https,
# off for plain-http local dev). Uncomment to force either way.
#SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# ---- File uploads: ebook PDFs up to 200 MB ----
# PHP itself must allow the upload: the production Dockerfile writes
# uploads.ini (upload_max_filesize=200M, post_max_size=210M,
# memory_limit=512M, max_execution_time=300). For local dev, raise these in
# your php.ini too, or uploads over ~2 MB fail before Laravel sees them.
# BookRequest caps PDFs at 200 MB ('max:204800') and covers at 2 MB.
#
# Railway's container disk is EPHEMERAL: every redeploy wipes
# storage/app/private (ebook PDFs) and storage/app/public (covers) while
# books.file_path stays in MySQL — after which every download fails with
# "file is not available yet". Mount a Railway Volume (e.g. at /data) and
# point the disks at it so uploads survive redeploys:
#PRIVATE_STORAGE_PATH=/data/private
#PUBLIC_STORAGE_PATH=/data/public

CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@myebookbazaar.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Phase 1: customer email verification toggle ----
EMAIL_VERIFICATION_ENABLED=true

# ---- Phase 1: first admin account (created by AdminSeeder) ----
# IMPORTANT: change this password right after your first login at /reddy/login
# via Reddy > Change Password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# ---- Cloudflare Turnstile (bot protection; server verification lands in Phase 6) ----
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Support contact shown in the footer ----
SUPPORT_EMAIL=support@myebookbazaar.com

VITE_APP_NAME="${APP_NAME}"
