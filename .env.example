APP_NAME="MyEbookBazaar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000
# Set to * when behind Cloudflare (see DEPLOY.md section 10); leave empty otherwise.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Database: MySQL ONLY (Phase 1 spec) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=myebookbazaar
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production (HTTPS) for Secure cookies. HttpOnly + SameSite=Lax are always on.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@myebookbazaar.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Phase 1: customer email verification toggle ----
EMAIL_VERIFICATION_ENABLED=true

# ---- Phase 1: first admin account (created by AdminSeeder) ----
# IMPORTANT: change this password right after your first login at /reddy/login
# via Reddy > Change Password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# ---- Cloudflare Turnstile (bot protection; server verification lands in Phase 6) ----
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Support contact shown in the footer ----
SUPPORT_EMAIL=support@myebookbazaar.com

VITE_APP_NAME="${APP_NAME}"
